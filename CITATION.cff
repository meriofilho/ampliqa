    given-names: "Romério de Oliveira"
    affiliation: "Dalmolin Systems Biology Group, Graduate Program in Bioinformatics, Federal University of Rio Grande do Norte (UFRN), Brazil"
keywords:
  - RT-qPCR
  - gene expression
  - delta-delta Ct
  - qBase
  - geNorm
  - MIQE
  - Streamlit
  - zebrafish
references:
